# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/ebook_market

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AUTH
AUTH_SECRET=your-random-secret-key-min-32-chars-change-in-production

# EMAIL (Nodemailer)
EMAIL_FROM=noreply@ebook-market.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# PAYMENT (optional - Phase 9)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
PAYPAL_CLIENT_ID=xxx
PAYPAL_SECRET=xxx

# FEATURES
FEATURE_AI_SEARCH=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_WHATSAPP=false

# ADMIN
ADMIN_EMAIL=admin@ebook-market.com
ADMIN_PASSWORD=change-me-in-production
